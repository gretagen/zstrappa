#!/bin/bash
# zstrappa - Install Haliade system to a target device

set -e

usage() {
    cat <<EOF
Usage: zstrappa [options] <root-device> [boot-device]

Options:
  --uefi        Force UEFI bootloader installation
  --bios        Force BIOS/legacy bootloader installation

Install Haliade system from the live ISO to a target block device.

Arguments:
  root-device   Target root partition (e.g. /dev/sda2, /dev/nvme0n1p2)
  boot-device   Optional separate boot partition (e.g. /dev/sda1)

Examples:
  zstrappa /dev/sda2 /dev/sda1
  zstrappa --uefi /dev/sda2 /dev/sda1

Note: For UEFI, the boot partition is auto-formatted as FAT32.
EOF
    exit 1
}

UEFI_OVERRIDE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --uefi) UEFI_OVERRIDE=1; shift ;;
        --bios) UEFI_OVERRIDE=0; shift ;;
        -h|--help) usage ;;
        --) shift; break ;;
        *) break ;;
    esac
done

[ $# -ge 1 ] || usage

ROOT_DEV="$1"
BOOT_DEV="$2"
MP="/mnt/target"
BOOT_MOUNTED=false

check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: zstrappa must be run with root privileges" >&2
        exit 1
    fi
}

validate_device() {
    local dev="$1" label="$2"
    if [ ! -b "$dev" ]; then
        echo "Error: $label $dev is not a block device" >&2
        exit 1
    fi
    if mount | grep -q "^$dev "; then
        echo "Error: $label $dev is already mounted" >&2
        exit 1
    fi
}

detect_uefi() {
    if [ -n "$UEFI_OVERRIDE" ]; then
        [ "$UEFI_OVERRIDE" = "1" ]
        return
    fi
    [ -d /sys/firmware/efi ]
}

setup_boot_partition_uefi() {
    local part_num disk fstype
    part_num=$(echo "$BOOT_DEV" | grep -o '[0-9]*$')
    disk=$(echo "$BOOT_DEV" | sed 's/[0-9]*$//')
    disk=$(echo "$disk" | sed 's/p$//')

    fstype=$(blkid -s TYPE -o value "$BOOT_DEV" 2>/dev/null || echo "")

    if [ "$fstype" = "vfat" ]; then
        echo "Boot partition $BOOT_DEV is already FAT32."
        return
    fi

    echo "Formatting $BOOT_DEV as FAT32 (EFI System Partition)..."
    mkfs.vfat -v -F 32 "$BOOT_DEV" || {
        echo "Error: Failed to format $BOOT_DEV as FAT32" >&2
        exit 1
    }

    if sfdisk -d "$disk" 2>/dev/null | grep -q 'label: gpt'; then
        echo "Setting partition type to EFI System (C12A7328-F81F-11D2-BA4B-00A0C93EC93B)..."
        sfdisk --part-type "$disk" "$part_num" "C12A7328-F81F-11D2-BA4B-00A0C93EC93B" || {
            echo "Warning: Failed to set GPT partition type" >&2
        }
    fi
}

mount_target() {
    if detect_uefi; then
        if [ -z "$BOOT_DEV" ]; then
            echo "Error: --uefi requires a boot partition (ESP)" >&2
            exit 1
        fi
        setup_boot_partition_uefi
    fi
    mount -t tmpfs tmpfs /mnt
    mkdir -p "$MP"
    echo "Formatting $ROOT_DEV as btrfs..."
    mkfs.btrfs -f -L haliade "$ROOT_DEV" || {
        echo "Error: Failed to format $ROOT_DEV" >&2
        exit 1
    }

    # Create @ (live root) and @snapshots layout on the top-level volume
    local tl
    tl=$(mktemp -d /mnt/zstrappa-tl.XXXXXX)
    mount "$ROOT_DEV" "$tl" || {
        echo "Error: Failed to mount $ROOT_DEV for subvolume setup" >&2
        exit 1
    }
    echo "Creating btrfs subvolumes @ and @snapshots..."
    btrfs subvolume create "$tl/@" || {
        echo "Error: Failed to create @ subvolume" >&2
        umount "$tl"; rmdir "$tl"
        exit 1
    }
    btrfs subvolume create "$tl/@snapshots" || {
        echo "Error: Failed to create @snapshots subvolume" >&2
        umount "$tl"; rmdir "$tl"
        exit 1
    }
    umount "$tl"
    rmdir "$tl"

    mount -o subvol=@ "$ROOT_DEV" "$MP" || {
        echo "Error: Failed to mount $ROOT_DEV subvol=@ on $MP" >&2
        exit 1
    }
    mkdir -p "$MP/.snapshots"
    mount -o subvol=@snapshots "$ROOT_DEV" "$MP/.snapshots" || {
        echo "Error: Failed to mount @snapshots on $MP/.snapshots" >&2
        umount "$MP"
        exit 1
    }
    if [ -n "$BOOT_DEV" ]; then
        mkdir -p "$MP/boot"
        mount "$BOOT_DEV" "$MP/boot" || {
            echo "Error: Failed to mount $BOOT_DEV on $MP/boot" >&2
            umount "$MP/.snapshots" 2>/dev/null || true
            umount "$MP"
            exit 1
        }
        BOOT_MOUNTED=true
    fi
}



# Live boot artifacts, as the running ISO's tmpfs overlay presents them in /.
# haliade-iso-regen writes /usr/sbin/haliade-boot-intro at boot into the
# overlay's RAM upper layer, and the initramfs touches /fastboot, so a live
# system copying itself to a target would otherwise hand those over. /intro is
# the artwork the live boot plays and nothing else uses.
#
# The animation wrapper is harmless on an installed system -- its kernel cmdline
# carries no init=, so nothing would ever exec it -- but it is dead weight.
#
# Removed before copying rather than merely filtered, so the install source is
# clean and a later rsync or manual copy cannot resurrect them. The leading
# slash anchors each path to the root. Note the wrapper is /usr/sbin/... and not
# /sbin/...: the rootfs has "sbin -> usr/sbin", so /sbin/haliade-boot-intro is
# the same file reached through a symlink and a /sbin pattern would not match.
LIVE_ONLY_PATHS="/intro
/usr/sbin/haliade-boot-intro
/fastboot"

# Drop the live overlay's artifacts from the install source. rm-ing a file that
# the overlay only has in its upper layer just deletes it; overlayfs whiteouts
# the ones that also exist below, so in every case the path stops being visible
# in / and the copy cannot pick it up. Running this on a system that has none of
# these is a no-op.
purge_live_only() {
    echo "Removing the live boot's artifacts from the install source..."
    local p removed=0
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        if [ -e "$p" ] || [ -L "$p" ]; then
            rm -f "$p" || {
                echo "Error: could not remove $p" >&2
                return 1
            }
            echo "  removed $p"
            removed=$((removed + 1))
        fi
    done <<< "$LIVE_ONLY_PATHS"
    [ "$removed" -gt 0 ] || echo "  nothing to remove (not a live system?)"
}

copy_rootfs() {
    echo "Copying root filesystem (this may take a while)..."
    local -a live_excludes=()
    local p
    while IFS= read -r p; do
        [ -n "$p" ] && live_excludes+=("--exclude=$p")
    done <<< "$LIVE_ONLY_PATHS"

    rsync -aHAX -P / "$MP" \
        --no-owner --no-group \
        --exclude=/dev \
        --exclude=/proc \
        --exclude=/sys \
        --exclude=/run \
        --exclude=/tmp \
        --exclude=/mnt \
        --exclude=/lost+found \
        --exclude=/.snapshots \
        --exclude=/.tmp-anims \
        "${live_excludes[@]}"
}

# Belt and braces for the two lists above. If haliade-iso-regen ever grows a new
# live-only artifact and this list is not updated, catch it here rather than
# discovering it as a mysteriously clearing login prompt on the installed
# system. Runs before the bootloader is written, so a failure stops the install
# while it is still recoverable.
verify_no_live_only() {
    local p found=()
    while IFS= read -r p; do
        [ -n "$p" ] && [ -e "$MP$p" ] && found+=("$p")
    done <<< "$LIVE_ONLY_PATHS"
    if [ ${#found[@]} -ne 0 ]; then
        echo "Error: live-only paths reached the target:" >&2
        printf '  %s\n' "${found[@]}" >&2
        echo "Update LIVE_ONLY_PATHS to match haliade-iso-regen." >&2
        return 1
    fi
    echo "Verified: no live boot artifacts on the target."
}

get_uuid() {
    blkid -s UUID -o value "$1" 2>/dev/null
}

get_partuuid() {
    blkid -s PARTUUID -o value "$1" 2>/dev/null
}

update_boot_config() {
    local root_uuid part_uuid root_spec kernel initrd extras
    root_uuid=$(get_uuid "$ROOT_DEV")
    part_uuid=$(get_partuuid "$ROOT_DEV")

    if [ -n "$root_uuid" ]; then
        root_spec="UUID=$root_uuid"
    elif [ -n "$part_uuid" ]; then
        root_spec="PARTUUID=$part_uuid"
    else
        root_spec="$ROOT_DEV"
    fi

    # Prefer kernels already copied onto the target boot partition
    kernel=$(ls "$MP/boot"/vmlinuz-* 2>/dev/null | head -1 | xargs -r basename)
    [ -n "$kernel" ] || kernel="vmlinuz-6.18.10-gen"
    if [ -f "$MP/boot/initramfs-core.img" ]; then
        initrd="initramfs-core.img"
    else
        initrd=$(ls "$MP/boot"/initramfs-*.img 2>/dev/null | head -1 | xargs -r basename)
        [ -n "$initrd" ] || initrd="initramfs-core.img"
    fi

    extras=""
    if [ -f "$MP/etc/haliade/definition.lua" ]; then
        extras=$(sed -n 's/.*kernel_cmdline[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$MP/etc/haliade/definition.lua" | head -1)
    fi

    local limine_conf="$MP/boot/limine.conf"
    echo "Writing boot configuration (root=$root_spec rootflags=subvol=@)..."
    cat > "$limine_conf" <<EOF
# Limine configuration for Haliade system — managed by chronos
# Do not hand-edit generation entries; run: chronos rewrite-limine

timeout: 15
serial: yes

/Haliade SYS
    protocol: linux
    kernel_path: boot():/${kernel}
    module_path: boot():/${initrd}
    cmdline: root=${root_spec} rootflags=subvol=@ rw ${extras} init=/sbin/openrc-init
EOF
}



generate_fstab() {
    local root_uuid boot_uuid root_spec
    root_uuid=$(get_uuid "$ROOT_DEV")

    if [ -n "$root_uuid" ]; then
        root_spec="UUID=$root_uuid"
    else
        root_spec="$ROOT_DEV"
    fi

    echo "Generating /etc/fstab..."
    cat > "$MP/etc/fstab" << FSTAB
# /etc/fstab - Generated by zstrappa
#
# /proc, /sys, /dev are mounted by initramfs and OpenRC devfs/sysfs services.
# Do NOT add them here — they conflict with OpenRC service ordering.

# ephemeral state (lost on reboot, kept in memory)
tmpfs           /run            tmpfs           nosuid,nodev,mode=0755 0 0
tmpfs           /tmp            tmpfs           nosuid,nodev,mode=1777 0 0
tmpfs           /var/log        tmpfs           nosuid,nodev,mode=0755 0 0
tmpfs           /var/cache      tmpfs           nosuid,nodev,mode=0755 0 0
tmpfs           /var/tmp        tmpfs           nosuid,nodev,mode=1777 0 0
tmpfs           /var/lock       tmpfs           nosuid,nodev,mode=0755 0 0

# btrfs generations layout
${root_spec} / btrfs subvol=@,defaults,noatime 0 1
${root_spec} /.snapshots btrfs subvol=@snapshots,defaults,noatime 0 0
FSTAB

    if [ "$BOOT_MOUNTED" = "true" ]; then
        boot_uuid=$(get_uuid "$BOOT_DEV")
        if [ -n "$boot_uuid" ]; then
            echo "UUID=$boot_uuid /boot vfat defaults,nofail 0 0" >> "$MP/etc/fstab"
        else
            echo "$BOOT_DEV /boot auto defaults,nofail 0 0" >> "$MP/etc/fstab"
        fi
    fi
}



create_dirs() {
    for d in proc proc/sysrq-trigger sys dev dev/pts run run/openrc tmp .snapshots \
             var/lib var/lib/iwd var/log var/cache; do
        mkdir -p "$MP/$d"
    done
}

# Make sure the initramfs mounts /run with source "tmpfs" so libmount's mount -a
# (OpenRC localmount) sees fstab's "tmpfs /run tmpfs" as already mounted instead
# of stacking a second empty /run on top that shadows OpenRC's runtime state.
fix_initramfs_run_mount() {
    local f="$1"
    [ -f "$f" ] || return 0
    if grep -q 'mount -t tmpfs run /run' "$f"; then
        sed -i 's|mount -t tmpfs run /run|mount -t tmpfs tmpfs /run|' "$f"
        echo "  fixed /run mount source in $f"
    fi
}

# Verify the generated initramfs mounts /run as "tmpfs" (never "run").
verify_initramfs_run_mount() {
    local img="$1" tmp
    tmp=$(mktemp -d)
    (cd "$tmp" && lsinitcpio -x --cpio "$img" 2>/dev/null)
    if grep -q 'mount -t tmpfs tmpfs /run' "$tmp/init_functions" 2>/dev/null && \
       ! grep -q 'mount -t tmpfs run /run' "$tmp/init_functions" 2>/dev/null; then
        rm -rf "$tmp"
        return 0
    fi
    rm -rf "$tmp"
    return 1
}

ensure_installed_initramfs() {
    echo "Reusing shipped initramfs (no regeneration)..."

    # The installed initramfs ships pre-built inside this live rootfs as
    # boot/initramfs-core.img and is copied to the target by copy_rootfs.
    # We do NOT regenerate it here: mkinitcpio against the read-only live
    # squashfs (host-side init_functions / mkinitcpio-installed.conf) fails,
    # and regenerating per-install is unnecessary — the shipped image is the
    # one that was boot-tested.
    if [ ! -s "$MP/boot/initramfs-core.img" ]; then
        echo "Error: boot/initramfs-core.img not found after rootfs copy" >&2
        return 1
    fi

    # A reinstall target can still carry the pre-rename image: copy_rootfs has
    # no --delete, so initramfs-installed.img from an earlier install survives
    # next to the fresh core.img, and chronos would then generate boot entries
    # pointing at it. Drop it here so the target converges on initramfs-core.
    if [ -e "$MP/boot/initramfs-installed.img" ] || [ -L "$MP/boot/initramfs-installed.img" ]; then
        echo "  removing stale boot/initramfs-installed.img (pre-rename image)"
        rm -f "$MP/boot/initramfs-installed.img" || {
            echo "Error: could not remove stale boot/initramfs-installed.img" >&2
            return 1
        }
    fi

    if ! verify_initramfs_run_mount "$MP/boot/initramfs-core.img"; then
        echo "Error: shipped initramfs mounts /run with source 'run', not 'tmpfs'; refusing to install" >&2
        return 1
    fi
    echo "  initramfs: $MP/boot/initramfs-core.img ($(du -h "$MP/boot/initramfs-core.img" | cut -f1))"

    # Keep the target's on-disk mkinitcpio init_functions patched so any later
    # manual regeneration outside zstrappa also produces a correct /run mount.
    for f in "$MP"/usr/lib/initcpio/init_functions "$MP"/usr/lib64/initcpio/init_functions; do
        fix_initramfs_run_mount "$f"
    done
}

fix_permissions() {
    echo "Fixing post-install permissions..."
    # impala needs setuid for iwd wireless management
    if [ -f "$MP/usr/bin/impala" ]; then
        chmod 4755 "$MP/usr/bin/impala"
        echo "Set impala setuid (4755)"
    fi
    # iwd helper needs setuid for network operations
    if [ -f "$MP/usr/libexec/iwd" ]; then
        chmod 4755 "$MP/usr/libexec/iwd"
        echo "Set iwd setuid (4755)"
    fi
}

install_bootloader_uefi() {
    local esp_mnt="$MP/boot"
    local esp_mounted=false

    # Mount ESP if not already mounted
    if ! mountpoint -q "$esp_mnt" 2>/dev/null && [ -n "$BOOT_DEV" ]; then
        mount "$BOOT_DEV" "$esp_mnt" 2>/dev/null && esp_mounted=true
    elif mountpoint -q "$esp_mnt" 2>/dev/null; then
        esp_mounted=true
    fi

    if [ "$esp_mounted" = false ]; then
        echo "Warning: ESP not accessible, skipping bootloader install" >&2
        return
    fi

    echo "Installing UEFI bootloader..."
    mkdir -p "$esp_mnt/EFI/BOOT"
    local limine_efi=""
    for cand in "$MP/usr/share/limine/BOOTX64.EFI" /usr/share/limine/BOOTX64.EFI /EFI/BOOT/BOOTX64.EFI; do
        [ -f "$cand" ] && { limine_efi="$cand"; break; }
    done
    if [ -z "$limine_efi" ]; then
        echo "Error: no BOOTX64.EFI found (tried \$MP/usr/share/limine, /usr/share/limine, /EFI/BOOT)" >&2
        return
    fi
    cp -v "$limine_efi" "$esp_mnt/EFI/BOOT/BOOTX64.EFI" || {
        echo "Error: Failed to copy BOOTX64.EFI" >&2
        return
    }

    # Create firmware boot entry so the system appears in UEFI boot menu
    local disk part_num
    if [ -n "$BOOT_DEV" ]; then
        part_num=$(echo "$BOOT_DEV" | grep -o '[0-9]*$')
        disk=$(echo "$BOOT_DEV" | sed 's/[0-9]*$//;s/p$//')
    fi

    if [ -n "$disk" ] && [ -n "$part_num" ]; then
        if command -v efibootmgr &>/dev/null; then
            echo "Creating UEFI boot entry..."
            efibootmgr -c -d "$disk" -p "$part_num" -L "Haliade SYS" -l '\EFI\BOOT\BOOTX64.EFI' 2>&1 || {
                echo "Warning: Failed to create UEFI boot entry" >&2
                echo "Some firmware may not boot without a manual entry." >&2
                echo "You can add one later with:" >&2
                echo "  efibootmgr -c -d $disk -p $part_num -L 'Haliade SYS' -l '\\\\EFI\\\\BOOT\\\\BOOTX64.EFI'" >&2
            }
        else
            echo "Warning: efibootmgr not found. UEFI boot entry not created." >&2
            echo "Boot via fallback EFI/BOOT/BOOTX64.EFI (may not work on all firmware)." >&2
        fi
    else
        echo "Warning: Could not determine ESP disk/partition for boot entry." >&2
    fi

    echo "UEFI bootloader installed."
}

install_bootloader() {
    if detect_uefi; then
        install_bootloader_uefi
        return
    fi

    local disk
    disk=$(echo "$ROOT_DEV" | sed 's/[0-9]*$//')
    disk=$(echo "$disk" | sed 's/p$//')

    if [ -b "$disk" ]; then
        if sfdisk -d "$disk" 2>/dev/null | grep -q 'label: gpt'; then
            echo "Detected GPT partition table."
            if sfdisk -d "$disk" 2>/dev/null | grep -q 'type=21686148-6449-6E6F-744E-656564454649'; then
                echo "Installing Limine bootloader to $disk..."
                "$MP/usr/bin/limine" bios-install "$disk" || {
                    echo "Warning: limine bios-install failed" >&2
                }
            else
                echo "Warning: No BIOS boot partition (type ef02) found on GPT disk."
                echo "Attempting install with --force (embedding in GPT gap)..."
                "$MP/usr/bin/limine" bios-install --force "$disk" || {
                    echo "Error: limine bios-install failed." >&2
                    echo "If your system is UEFI, re-run with --uefi." >&2
                    echo "Otherwise, create a 1MB BIOS boot partition (type ef02) and re-run." >&2
                }
            fi
        else
            echo "Installing Limine bootloader to $disk..."
            "$MP/usr/bin/limine" bios-install "$disk" || {
                echo "Warning: limine bios-install failed" >&2
            }
        fi
    else
        echo "Warning: Could not determine parent disk for $ROOT_DEV" >&2
    fi
}

cleanup() {
    echo "Syncing and unmounting..."
    sync
    umount "$MP/sys" 2>/dev/null || true
    umount "$MP/proc" 2>/dev/null || true
    umount "$MP/dev/pts" 2>/dev/null || true
    umount "$MP/dev" 2>/dev/null || true
    if [ -n "$BOOT_DEV" ]; then
        umount "$MP/boot" 2>/dev/null || true
    fi
    umount "$MP/.snapshots" 2>/dev/null || true
    umount "$MP" 2>/dev/null || true
}

create_initial_generation() {
    echo "Creating initial generation (gen-1)..."
    # Snapshot @ -> @snapshots/gen-1 from the top-level
    local tl
    tl=$(mktemp -d /mnt/zstrappa-gen.XXXXXX)
    if ! mount -t btrfs -o subvol=/ "$ROOT_DEV" "$tl"; then
        echo "Warning: could not mount top-level for initial generation" >&2
        rmdir "$tl" 2>/dev/null || true
        return 0
    fi
    if [ -d "$tl/@snapshots/gen-1" ]; then
        btrfs subvolume delete "$tl/@snapshots/gen-1" 2>/dev/null || true
    fi
    if btrfs subvolume snapshot -r "$tl/@" "$tl/@snapshots/gen-1"; then
        local ts
        ts=$(date +%s)
        # meta beside RO snap (cannot write inside RO subvolume)
        if [ -d "$MP/.snapshots" ]; then
            cat > "$MP/.snapshots/gen-1.meta.toml" <<EOF
id = "gen-1"
timestamp = $ts
description = "initial installation"
EOF
            echo "gen-1" > "$MP/.snapshots/.current"
        fi
        echo "Initial generation gen-1 created."
    else
        echo "Warning: failed to create initial generation" >&2
    fi
    umount "$tl" 2>/dev/null || true
    rmdir "$tl" 2>/dev/null || true

    # Expand limine with Generations submenu
    if [ -x "$MP/usr/bin/chronos" ]; then
        # Run chronos rewrite against the installed tree's /boot
        mount --bind /dev "$MP/dev" 2>/dev/null || true
        mount --bind /proc "$MP/proc" 2>/dev/null || true
        mount --bind /sys "$MP/sys" 2>/dev/null || true
        chroot "$MP" /usr/bin/chronos rewrite-limine 2>/dev/null || {
            echo "Warning: chronos rewrite-limine failed; writing submenu manually" >&2
            append_generation_limine_entry
        }
        umount "$MP/sys" 2>/dev/null || true
        umount "$MP/proc" 2>/dev/null || true
        umount "$MP/dev" 2>/dev/null || true
    else
        append_generation_limine_entry
    fi
}

append_generation_limine_entry() {
    local limine_conf="$MP/boot/limine.conf"
    [ -f "$limine_conf" ] || return 0
    # Already has Generations?
    grep -q '^/Generations' "$limine_conf" 2>/dev/null && return 0

    local root_uuid part_uuid root_spec kernel initrd cmdline extras
    root_uuid=$(get_uuid "$ROOT_DEV")
    part_uuid=$(get_partuuid "$ROOT_DEV")
    if [ -n "$root_uuid" ]; then
        root_spec="UUID=$root_uuid"
    elif [ -n "$part_uuid" ]; then
        root_spec="PARTUUID=$part_uuid"
    else
        root_spec="$ROOT_DEV"
    fi
    kernel=$(ls "$MP/boot"/vmlinuz-* 2>/dev/null | head -1 | xargs -r basename)
    [ -n "$kernel" ] || kernel="vmlinuz-6.16.1-defzrn"
    if [ -f "$MP/boot/initramfs-core.img" ]; then
        initrd="initramfs-core.img"
    else
        initrd=$(ls "$MP/boot"/initramfs-*.img 2>/dev/null | head -1 | xargs -r basename)
        [ -n "$initrd" ] || initrd="initramfs-core.img"
    fi
    extras=""
    cmdline=$(grep -m1 'cmdline:' "$limine_conf" | sed 's/.*cmdline:[[:space:]]*//')
    for tok in $cmdline; do
        case "$tok" in
            root=*|rootflags=*|rw|ro) ;;
            *) extras="${extras:+$extras }$tok" ;;
        esac
    done

    cat >> "$limine_conf" <<EOF

/Generations
    //Haliade SYS (Generation 1)
        protocol: linux
        kernel_path: boot():/${kernel}
        module_path: boot():/${initrd}
        cmdline: root=${root_spec} rootflags=subvol=@snapshots/gen-1 rw ${extras}
EOF
}

verify_boot_files() {
    local boot_dir="$MP/boot" missing=""
    [ -d "$boot_dir" ] || { echo "Error: $boot_dir missing" >&2; return 1; }
    ls "$boot_dir"/vmlinuz-* >/dev/null 2>&1 || missing="$missing vmlinuz"
    if ! ls "$boot_dir"/initramfs-*.img >/dev/null 2>&1 && \
       ! ls "$boot_dir"/initrd-* >/dev/null 2>&1; then
        missing="$missing initramfs"
    fi
    [ -f "$boot_dir/limine.conf" ] || missing="$missing limine.conf"
    if [ -n "$missing" ]; then
        echo "Error: boot files missing on target:${missing}" >&2
        ls -la "$boot_dir" >&2 || true
        return 1
    fi
    echo "Verified boot files in $boot_dir:"
    local f
    for f in "$boot_dir"/vmlinuz-* "$boot_dir"/initramfs-*.img "$boot_dir"/initrd-* "$boot_dir"/limine.conf; do
        [ -e "$f" ] && echo "  $(basename "$f")"
    done
}

check_root
validate_device "$ROOT_DEV" "root"
[ -n "$BOOT_DEV" ] && validate_device "$BOOT_DEV" "boot"

read -rp "Bootstrap this Haliade system? this will wipe the whole drive, this action cannot be undone. [Y/n] : " choice

case "$choice" in
    [Yy])
      echo "Now bootstrapping..."
      sleep 1
      trap cleanup EXIT
      purge_live_only
      mount_target
      copy_rootfs
      create_dirs
      fix_permissions
      update_boot_config
      verify_no_live_only
      verify_boot_files
      generate_fstab
      install_bootloader
      create_initial_generation
      echo "The Haliade system has been successfully bootstrapped and installed on your machine, you can reboot now."
      ;;
    *)
      echo "Cancelled."
      exit 0
      ;;
esac


